# Firebase-projektin asetukset. Kopioi tämä tiedosto nimelle .env ja täytä arvot.
# Löydät arvot Firebase-konsolista: Project settings -> Your apps -> SDK setup and configuration.
# Ilman näitä sovellus toimii silti ja tallentaa laukaukset selaimen localStorageen.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Salibandyn tulospalvelu (Torneopal). Toimii oletusarvoilla ilman näitä.
# Aseta nämä vain jos sarja/joukkue vaihtuu tai haluat oman API-avaimen.
# COMPETITION_ID vaihtuu joka kausi (sb2026 = kausi 2026–2027).
VITE_TORNEOPAL_API_BASE=
VITE_TORNEOPAL_API_KEY=
VITE_TORNEOPAL_COMPETITION_ID=
VITE_TORNEOPAL_CATEGORY_ID=
VITE_TORNEOPAL_TEAM_ID=
