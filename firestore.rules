rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pelkkä kirjautuminen ei riitä: Google-kirjautuminen luo tilin kenelle
    // tahansa. Vain tällä listalla olevat tilit pääsevät dataan käsiksi.
    // Uuden käyttäjän lisääminen = lisää sähköposti tähän ja julkaise säännöt.
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email in [
          'matti.kaehkoenen@gmail.com',
          'veska@gg.wp'
        ];
    }

    match /shots/{shotId} {
      allow read, write: if isAllowedUser();
    }
    match /locked_periods/{lockId} {
      allow read, write: if isAllowedUser();
    }
    match /completed_matches/{matchId} {
      allow read, write: if isAllowedUser();
    }
  }
}
