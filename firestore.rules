rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Käyttäjähallinta tapahtuu Firebase Authenticationin puolella,
    // joten riittää että käyttäjä on kirjautunut sisään.
    function isAllowedUser() {
      return request.auth != null;
    }

    match /shots/{shotId} {
      allow read, write: if isAllowedUser();
    }
    match /locked_periods/{lockId} {
      allow read, write: if isAllowedUser();
    }
    match /completed_matches/{matchId} {
      allow read, write: if isAllowedUser();
    }
  }
}
